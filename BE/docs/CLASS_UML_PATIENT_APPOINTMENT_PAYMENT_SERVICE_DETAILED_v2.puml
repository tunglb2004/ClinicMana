' ==================== CONTROLLER LAYER ====================

class PatientManagementController <<RestController>> {
    + getAllPatients(page, size, sortBy, sortDir, keyword, isActive) : ResponseEntity<PageResponse<UserDetailResponse>>
    + getPatientById(patientId) : ResponseEntity<UserDetailResponse>
    + createPatient(request) : ResponseEntity<UserDetailResponse>
    + updatePatient(patientId, request) : ResponseEntity<UserDetailResponse>
    + deletePatient(patientId) : ResponseEntity<MessageResponse>
    + lockPatient(patientId) : ResponseEntity<MessageResponse>
    + unlockPatient(patientId) : ResponseEntity<MessageResponse>
}

class PatientController <<RestController>> {
    + getPatients(page, size, keyword, sortBy, sortDir, today) : ApiResponse<PageResponse<PatientResponse>>
    + updatePatient(patientId, request) : ApiResponse<PatientResponse>
    + deletePatient(patientId) : ApiResponse<String>
}

' ==================== SERVICE LAYER ====================

class PatientManagementService <<Service>> {
    + getAllPatients(page, size, sortBy, sortDir, keyword, isActive) : PageResponse<UserDetailResponse>
    + getPatientById(userId) : UserDetailResponse
    + createPatient(request) : UserDetailResponse
    + updatePatient(userId, request) : UserDetailResponse
    + deletePatient(userId) : MessageResponse
    + lockPatient(userId) : MessageResponse
    + unlockPatient(userId) : MessageResponse
}

class PatientService <<Service>> {
    + getPatients(page, size, keyword, sortBy, sortDir, today) : PageResponse<PatientResponse>
    + updatePatient(patientId, request) : PatientResponse
    + deletePatient(patientId) : void
}

' ==================== REPOSITORY LAYER ====================

class PatientRepository <<Repository>> {
    + findByKeyword(keyword, pageable) : Page<Patient>
    + findByKeywordAndDateRange(keyword, startDate, endDate, pageable) : Page<Patient>
    + findByUserId(userId) : Optional<Patient>
    + findByPhoneNumber(phoneNumber) : Optional<Patient>
    + findByCccd(cccd) : Optional<Patient>
    + existsByPatientId(patientId) : boolean
}

class UserRepository <<Repository>> {
    + findByUsername(username) : Optional<User>
    + findByEmail(email) : Optional<User>
    + findByPhoneNumber(phoneNumber) : Optional<User>
    + existsByEmail(email) : Boolean
    + existsByPhoneNumber(phoneNumber) : Boolean
    + existsByCccd(cccd) : Boolean
    + searchUsers(keyword, role, pageable) : Page<User>
    + findByKeywordAndIsDeleted(keyword, isDeleted, pageable) : Page<User>
    + findByRoleAndIsDeleted(roleName, isDeleted, pageable) : Page<User>
    + findByRoleAndKeyword(roleName, keyword, isDeleted, pageable) : Page<User>
    + findByRoleAndIsActive(roleName, isActive, isDeleted, pageable) : Page<User>
}

' ==================== ENTITY LAYER ====================

class Patient <<Entity>> {
    - patientId : String
    - dateOfBirth : LocalDate
    - bloodType : String
    - healthInsuranceNumber : String
    - allergies : String
    - address : String
    - height : BigDecimal
    - weight : BigDecimal
    - backgroundDisease : String
    - emergencyContactName : String
    - emergencyContactPhone : String
    - emergencyContactRelationship : String
}

class User <<Entity>> {
    - userId : Long
    - username : String
    - email : String
    - passwordHash : String
    - fullName : String
    - cccd : String
    - phoneNumber : String
    - avatarUrl : String
    - staffId : String
    - gender : Gender
    - isActive : Boolean
    - isDeleted : Boolean
    - mustChangePassword : Boolean
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
}

class Role <<Entity>> {
    - roleId : Integer
    - roleName : String
    - description : String
}

' ==================== ENUMERATIONS ====================

enum Gender <<enumeration>> {
    MALE
    FEMALE
    OTHER
}

' ==================== ASSOCIATIONS ====================

Patient "1" -- "1" User : belongs to >
User "*" -- "*" Role : has >
User -- Gender : has >

' ==================== DEPENDENCIES ====================

PatientManagementController ..> PatientManagementService : uses
PatientController ..> PatientService : uses
PatientManagementService ..> PatientRepository : uses
PatientManagementService ..> UserRepository : uses
PatientService ..> PatientRepository : uses
PatientRepository ..> Patient : manages
UserRepository ..> User : manages

@enduml


