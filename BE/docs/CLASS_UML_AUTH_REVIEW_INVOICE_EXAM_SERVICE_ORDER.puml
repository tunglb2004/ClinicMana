' ==================== DEPENDENCIES ====================
ReviewController ..> ReviewService : uses
ReviewService ..> ReviewRepository : uses
@enduml

@startuml
title 34. Gửi phản hồi (Send Response to Feedback)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam wrapWidth 320
skinparam linetype ortho
hide empty members

' ==================== CONTROLLER LAYER ====================
class ReviewController <<RestController>> {
  + replyReview(reviewId, request) : ReviewResponse
}

' ==================== SERVICE LAYER ====================
class ReviewService <<Service>> {
  + replyReview(reviewId, request, userId) : ReviewResponse
}

' ==================== REPOSITORY LAYER ====================
class ReviewRepository <<Repository>> {
  + findByReviewIdAndIsDeletedFalse(reviewId) : Review
  + save(review) : Review
}
class UserRepository <<Repository>> {
  + findById(userId) : User
}

' ==================== ENTITY LAYER ====================
class Review <<Entity>> {
  - reviewId : Long
  - comment : String
  - replyContent : String
  - replyAt : LocalDateTime
  - createdAt : LocalDateTime
}
class Patient <<Entity>> {
  - patientId : String
}
class Doctor <<Entity>> {
  - doctorId : String
  - specialization : String
}
class Appointment <<Entity>> {
  - appointmentId : String
  - appointmentDate : LocalDate
}
class User <<Entity>> {
  - userId : Long
  - fullName : String
  - email : String
}

' ==================== ASSOCIATIONS ====================
Review "*" --> "1" Patient : written by >
Review "*" --> "0..1" Doctor : about >
Review "*" --> "0..1" Appointment : for >
Review "*" --> "0..1" User : replied by >
ReviewRepository ..> Review : manages
UserRepository ..> User : manages

' ==================== DEPENDENCIES ====================
ReviewController ..> ReviewService : uses
ReviewService ..> ReviewRepository : uses
ReviewService ..> UserRepository : uses
@enduml