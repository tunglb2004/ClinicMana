@startuml
title 1. Xem danh sách tài khoản khách hàng (View Customer Account List)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam wrapWidth 320
skinparam linetype ortho
hide empty members

' ==================== CONTROLLER LAYER ====================
class PatientManagementController <<RestController>> {
  + getAllPatients(page, size, sortBy, sortDir, keyword, isActive) : ResponseEntity<PageResponse<UserDetailResponse>>
  + getPatientById(patientId) : ResponseEntity<UserDetailResponse>
}

' ==================== SERVICE LAYER ====================
class PatientManagementService <<Service>> {
  + getAllPatients(page, size, sortBy, sortDir, keyword, isActive) : PageResponse<UserDetailResponse>
  + getPatientById(userId) : UserDetailResponse
}

' ==================== REPOSITORY LAYER ====================
class UserRepository <<Repository>> {
  + searchUsers(keyword, role, pageable) : Page<User>
  + findByRoleAndKeyword(roleName, keyword, isDeleted, pageable) : Page<User>
  + findByRoleAndIsActive(roleName, isActive, isDeleted, pageable) : Page<User>
}
class PatientRepository <<Repository>> {
  + findByKeyword(keyword, pageable) : Page<Patient>
  + findByUserId(userId) : Optional<Patient>
}

' ==================== ENTITY LAYER ====================
class User <<Entity>> {
  - userId : Long
  - username : String
  - email : String
  - fullName : String
  - phoneNumber : String
  - cccd : String
  - gender : Gender
  - isActive : Boolean
  - isDeleted : Boolean
}
class Patient <<Entity>> {
  - patientId : String
  - dateOfBirth : LocalDate
  - healthInsuranceNumber : String
  - address : String
}
class Role <<Entity>> {
  - roleId : Integer
  - roleName : String
}

enum Gender <<enumeration>> {
  MALE
  FEMALE
  OTHER
}

' ==================== ASSOCIATIONS ====================
Patient "1" -- "1" User : belongs to >
User "0..*" -- "0..*" Role : has >
User --> Gender : has >
UserRepository ..> User : manages
PatientRepository ..> Patient : manages

' ==================== DEPENDENCIES ====================
PatientManagementController ..> PatientManagementService : uses
PatientManagementService ..> UserRepository : uses
PatientManagementService ..> PatientRepository : uses
@enduml

