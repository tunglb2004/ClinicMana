@startuml
title 4. Tạo lịch hẹn cho khách hàng (ghi nhận lịch khám dự kiến)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam wrapWidth 320
skinparam linetype ortho
hide empty members

' ==================== CONTROLLER LAYER ====================
class AppointmentController <<RestController>> {
  + getAvailableSlots(date, serviceIds) : ApiResponse<List<AvailableSlotResponse>>
  + getClinicalRooms(slotId, date) : ApiResponse<List<Map<String, Object>>>
  + createAppointment(request) : ApiResponse<AppointmentResponse>
}

' ==================== SERVICE LAYER ====================
class AppointmentService <<Service>> {
  + getAvailableSlots(date, serviceIds) : List<AvailableSlotResponse>
  + createAppointment(request) : AppointmentResponse
}

' ==================== REPOSITORY LAYER ====================
class PatientRepository <<Repository>> {
  + findById(patientId) : Patient
}
class DoctorRepository <<Repository>> {
  + findById(doctorId) : Doctor
  + findByRoomId(roomId) : List<Doctor>
}
class ServiceRepository <<Repository>> {
  + findById(serviceId) : Service
  + findAllByIds(serviceIds) : List<Service>
}
class RoomRepository <<Repository>> {
  + findById(roomId) : Room
  + findByDeptIdAndIsDeletedFalse(deptId) : List<Room>
}
class AppointmentRepository <<Repository>> {
  + save(appointment) : Appointment
  + countByDateAndTimeAndServiceId(appointmentDate, appointmentTime, serviceId) : long
}
class WorkingTimeSlotRepository <<Repository>> {
  + findAllActiveSlots() : List<WorkingTimeSlot>
}

' ==================== ENTITY LAYER ====================
class Patient <<Entity>> {
  - patientId : String
  - dateOfBirth : LocalDate
  - healthInsuranceNumber : String
  - address : String
}
class Doctor <<Entity>> {
  - doctorId : String
  - specialization : String
  - doctorType : DoctorType
}
class Service <<Entity>> {
  - serviceId : String
  - serviceName : String
  - price : BigDecimal
  - maxPatients : Integer
}
class Room <<Entity>> {
  - roomId : String
  - roomName : String
  - roomType : String
  - status : String
}
class Appointment <<Entity>> {
  - appointmentId : String
  - appointmentDate : LocalDate
  - appointmentTime : LocalTime
  - status : String
  - queueNumber : Integer
  - notes : String
}
class WorkingTimeSlot <<Entity>> {
  - slotId : Long
  - shiftName : String
  - startTime : LocalTime
  - endTime : LocalTime
}

enum DoctorType <<enumeration>> {
  CLINICAL
  SPECIALIST
}

' ==================== ASSOCIATIONS ====================
Appointment "*" --> "1" Patient : booked by >
Appointment "*" --> "0..1" Doctor : assigned to >
Appointment "*" --> "0..1" Room : takes place in >
Appointment "*" --> "0..*" Service : includes >
Doctor --> DoctorType : has >
ServiceRepository ..> Service : manages
PatientRepository ..> Patient : manages
DoctorRepository ..> Doctor : manages
RoomRepository ..> Room : manages
AppointmentRepository ..> Appointment : manages
WorkingTimeSlotRepository ..> WorkingTimeSlot : manages

' ==================== DEPENDENCIES ====================
AppointmentController ..> AppointmentService : uses
AppointmentService ..> PatientRepository : uses
AppointmentService ..> DoctorRepository : uses
AppointmentService ..> ServiceRepository : uses
AppointmentService ..> RoomRepository : uses
AppointmentService ..> AppointmentRepository : uses
AppointmentService ..> WorkingTimeSlotRepository : uses
@enduml

@startuml
title 5. Thu tiền tạm ứng khám tổng quát (tiền mặt/QR)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam wrapWidth 320
skinparam linetype ortho
hide empty members

' ==================== CONTROLLER LAYER ====================
class PaymentController <<RestController>> {
  + collectPrepayment(request) : ApiResponse<PaymentResponse>
  + collectSupplementPayment(request) : ApiResponse<PaymentResponse>
  + sepayWebhook(payload, authorizationHeader) : ResponseEntity<String>
}

' ==================== SERVICE LAYER ====================
class PaymentService <<Service>> {
  + collectPrepayment(request) : PaymentResponse
  + collectSupplementPayment(request) : PaymentResponse
  + processSepayWebhook(payload, authorizationHeader) : void
}
class CitizenInsuranceService <<Service>> {
  + calculateInsuranceCoverage(recordId) : BigDecimal
}
class LoadBalancingService <<Service>> {
  + allocateRoom(recordId) : Room
}

' ==================== REPOSITORY LAYER ====================
class AppointmentRepository <<Repository>> {
  + findById(appointmentId) : Appointment
}
class MedicalRecordRepository <<Repository>> {
  + findByAppointmentId(appointmentId) : Optional<MedicalRecord>
  + save(record) : MedicalRecord
}
class InvoiceRepository <<Repository>> {
  + existsByAppointmentAndPaymentStatus(appointmentId, paymentStatus) : Boolean
  + save(invoice) : Invoice
}
class ServiceOrderRepository <<Repository>> {
  + findByRecordIdAndStatusAndInvoiceIdIsNull(recordId, status) : List<ServiceOrder>
}
class RoomRepository <<Repository>> {
  + findById(roomId) : Room
}

' ==================== ENTITY LAYER ====================
class Appointment <<Entity>> {
  - appointmentId : String
  - appointmentDate : LocalDate
  - appointmentTime : LocalTime
  - status : String
  - queueNumber : Integer
}
class MedicalRecord <<Entity>> {
  - recordId : String
  - symptoms : String
  - diagnosis : String
  - status : String
}
class Invoice <<Entity>> {
  - invoiceId : String
  - totalServiceFee : BigDecimal
  - insurancePaid : BigDecimal
  - customerPaid : BigDecimal
  - paymentStatus : String
  - paymentMethod : String
  - receiptNumber : String
}
class ServiceOrder <<Entity>> {
  - orderId : String
  - status : String
  - orderType : String
  - invoiceId : String
}
class Room <<Entity>> {
  - roomId : String
  - roomName : String
  - roomType : String
  - status : String
}
class Patient <<Entity>> {
  - patientId : String
  - healthInsuranceNumber : String
}
class Doctor <<Entity>> {
  - doctorId : String
  - specialization : String
}
class Service <<Entity>> {
  - serviceId : String
  - serviceName : String
  - price : BigDecimal
}

' ==================== ASSOCIATIONS ====================
Invoice "*" --> "1" MedicalRecord : belongs to >
MedicalRecord "1" -- "1" Appointment : generated from >
MedicalRecord "*" --> "1" Patient : belongs to >
MedicalRecord "*" --> "0..1" Doctor : examined by >
ServiceOrder "*" --> "1" MedicalRecord : belongs to >
ServiceOrder "*" --> "1" Service : for >
RoomRepository ..> Room : manages
AppointmentRepository ..> Appointment : manages
MedicalRecordRepository ..> MedicalRecord : manages
InvoiceRepository ..> Invoice : manages
ServiceOrderRepository ..> ServiceOrder : manages

' ==================== DEPENDENCIES ====================
PaymentController ..> PaymentService : uses
PaymentService ..> AppointmentRepository : uses
PaymentService ..> MedicalRecordRepository : uses
PaymentService ..> InvoiceRepository : uses
PaymentService ..> ServiceOrderRepository : uses
PaymentService ..> RoomRepository : uses
PaymentService ..> CitizenInsuranceService : uses
PaymentService ..> LoadBalancingService : uses
@enduml

@startuml
title 6. Quản lý dịch vụ (Thêm - Sửa - Xóa + Khóa/Mở khóa)
top to bottom direction
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam wrapWidth 320
skinparam linetype ortho
hide empty members

' ==================== CONTROLLER LAYER ====================
class ServiceController <<RestController>> {
  + getAllServices(category, deptId, includeInactive, authentication) : ApiResponse<List<Service>>
  + updateServiceConfig(serviceId, body) : ApiResponse<Service>
  + createService(request) : ApiResponse<Service>
  + updateService(serviceId, request) : ApiResponse<Service>
  + updateServiceStatus(serviceId, request) : ApiResponse<Service>
  + deleteService(serviceId) : ApiResponse<Void>
}

' ==================== SERVICE LAYER ====================
class ServiceManagementService <<Service>> {
  + createService(request) : Service
  + updateService(serviceId, request) : Service
  + updateServiceStatus(serviceId, isActive) : Service
  + deleteService(serviceId) : void
  + getVisibleServices(includeInactive) : List<Service>
}

' ==================== REPOSITORY LAYER ====================
class ServiceRepository <<Repository>> {
  + findAllByIsDeletedFalse() : List<Service>
  + findAllByIsDeletedFalseAndIsActiveTrue() : List<Service>
  + findByServiceIdAndIsDeletedFalse(serviceId) : Optional<Service>
  + findByServiceIdAndIsDeletedFalseAndIsActiveTrue(serviceId) : Optional<Service>
  + findAllByServiceIdInAndIsDeletedFalseAndIsActiveTrue(serviceIds) : List<Service>
}
class DepartmentRepository <<Repository>> {
  + findAllByIsDeletedFalse() : List<Department>
  + findAllByIsDeletedFalseAndIsActiveTrue() : List<Department>
  + findByDeptIdAndIsDeletedFalse(deptId) : Optional<Department>
  + existsByDeptNameAndIsDeletedFalse(deptName) : Boolean
}
class RoomRepository <<Repository>> {
  + findAllByIsDeletedFalse() : List<Room>
  + findByDeptIdAndIsDeletedFalse(deptId) : List<Room>
  + findByRoomIdAndIsDeletedFalse(roomId) : Optional<Room>
}

' ==================== ENTITY LAYER ====================
class Service <<Entity>> {
  - serviceId : String
  - serviceName : String
  - price : BigDecimal
  - description : String
  - isActive : Boolean
  - isDeleted : Boolean
  - bhytServiceCode : String
  - maxPatients : Integer
}
class Department <<Entity>> {
  - deptId : Integer
  - deptName : String
  - description : String
  - deptType : DeptType
  - isActive : Boolean
  - isDeleted : Boolean
}
class Room <<Entity>> {
  - roomId : String
  - roomName : String
  - roomType : String
  - location : String
  - status : String
  - isDeleted : Boolean
  - baseAvgTime : Integer
  - currentQueueLength : Integer
}

enum DeptType <<enumeration>> {
  CLINICAL
  PARACLINICAL
  ADMINISTRATIVE
  PHARMACY
}

' ==================== ASSOCIATIONS ====================
Service "*" -- "1" Department : belongs to >
Room "*" -- "1" Department : belongs to >
Service "*" -- "*" Room : supported by >
Department --> DeptType : has >
ServiceRepository ..> Service : manages
DepartmentRepository ..> Department : manages
RoomRepository ..> Room : manages

' ==================== DEPENDENCIES ====================
ServiceController ..> ServiceManagementService : uses
ServiceManagementService ..> ServiceRepository : uses
ServiceManagementService ..> DepartmentRepository : uses
ServiceManagementService ..> RoomRepository : uses
@enduml
