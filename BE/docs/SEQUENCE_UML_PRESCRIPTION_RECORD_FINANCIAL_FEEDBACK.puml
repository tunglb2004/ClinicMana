' ======================== CHỨC NĂNG 28 ========================
@startuml
title 28. Chuyển trạng thái bệnh án (Change Medical Record Status)
skinparam monochrome true
skinparam shadowing false

actor "Bác sĩ / Y tá" as Actor
participant "MedicalRecordController" as Controller
participant "MedicalRecordService" as Service
participant "MedicalRecordRepository" as MRRepo
participant "PrescriptionRepository" as PresRepo

Actor -> Controller : PATCH /api/medical-examination/records/\nupdate-examination-status/{id}\n(StatusUpdateRequest { newStatus })
activate Controller

Controller -> Service : updateExaminationStatus(id, newStatus)
activate Service

Service -> MRRepo : findById(id)
activate MRRepo
MRRepo --> Service : Optional<MedicalRecord>
deactivate MRRepo

alt Không tìm thấy
  Service --> Controller : AppException(MEDICAL_RECORD_NOT_FOUND)
  Controller --> Actor : 404 Error
end

Service -> Service : Kiểm tra chuyển trạng thái hợp lệ

note right of Service
  Quy tắc chuyển trạng thái:
  ✅ WAITING → EXAMINING
  ✅ WAITING → CANCELLED
  ✅ EXAMINING → FINISHED
  ✅ EXAMINING → CANCELLED
  ❌ Các trường hợp khác → Error
end note

alt Chuyển trạng thái không hợp lệ
  Service --> Controller : AppException(INVALID_STATUS_TRANSITION)
  Controller --> Actor : 400 Error
end

Service -> Service : record.setStatus(newStatus)

Service -> MRRepo : save(record)
activate MRRepo
MRRepo --> Service : MedicalRecord
deactivate MRRepo

Service -> PresRepo : findByMedicalRecord(record)
activate PresRepo
PresRepo --> Service : Optional<Prescription>
deactivate PresRepo

Service -> Service : mapToDetailResponse(record, prescription)
Service --> Controller : MedicalRecordDetailResponse
deactivate Service

Controller --> Actor : 200 OK\nApiResponse<MedicalRecordDetailResponse>
deactivate Controller
@enduml


