@startuml
title 29. Xác nhận kết quả khám (Confirm Examination Result)
skinparam monochrome true
skinparam shadowing false

actor "Bác sĩ" as Actor
participant "MedicalRecordController" as Controller
participant "MedicalRecordService" as Service
participant "MedicalRecordRepository" as MRRepo
participant "PrescriptionRepository" as PresRepo

Actor -> Controller : PATCH /api/medical-examination/records/\nconfirm-final-result/{id}
activate Controller

Controller -> Service : confirmFinalResult(id, currentUserId)
activate Service

Service -> MRRepo : findById(id)
activate MRRepo
MRRepo --> Service : Optional<MedicalRecord>
deactivate MRRepo

alt Không tìm thấy
  Service --> Controller : AppException(MEDICAL_RECORD_NOT_FOUND)
  Controller --> Actor : 404 Error
end

alt Trạng thái hiện tại ≠ EXAMINING
  Service --> Controller : AppException(INVALID_STATUS_TRANSITION)
  Controller --> Actor : 400 Error
end

Service -> PresRepo : findByMedicalRecord(record)
activate PresRepo
PresRepo --> Service : Optional<Prescription>
deactivate PresRepo

alt Chưa có đơn thuốc
  Service --> Controller : AppException(PRESCRIPTION_REQUIRED_FOR_CONFIRM)
  Controller --> Actor : 400 Error\n"Cần tạo đơn thuốc trước khi xác nhận"
end

Service -> Service : record.setStatus("FINISHED")

Service -> MRRepo : save(record)
activate MRRepo
MRRepo --> Service : MedicalRecord
deactivate MRRepo

Service -> Service : mapToDetailResponse(record, prescription)
Service --> Controller : MedicalRecordDetailResponse
deactivate Service

Controller --> Actor : 200 OK\nApiResponse<MedicalRecordDetailResponse>
deactivate Controller
@enduml


' ======================== CHỨC NĂNG 30 ========================
@startuml
title 30. Xem danh sách tài chính (View Financial List)
skinparam monochrome true
skinparam shadowing false

actor "Thu ngân" as Actor
participant "FinancialController" as Controller
participant "FinancialService" as Service
participant "AppointmentRepository" as ApptRepo
participant "ServiceOrderRepository" as SORepo
participant "InvoiceRepository" as InvRepo

== Luồng 1: Danh sách chưa thanh toán ==

Actor -> Controller : GET /api/financial/unpaid-records\n(?keyword, page, size)
activate Controller

Controller -> Service : getUnpaidRecords(page, size, keyword)
activate Service

Service -> Service : PageRequest.of(page-1, size)

Service -> ApptRepo : findUnpaidAppointments(keyword, pageable)
activate ApptRepo
ApptRepo --> Service : Page<Appointment>
deactivate ApptRepo

loop Mỗi Appointment
  Service -> Service : Lấy patient info, services
  Service -> Service : Tính tổng serviceFee
  Service -> Service : Map → FinancialResponse\n(invoiceId=appointmentId, patientName,\n totalServiceFee, serviceSummary)
end

Service --> Controller : PageResponse<FinancialResponse>
deactivate Service

Controller --> Actor : 200 OK
deactivate Controller

== Luồng 2: Danh sách cần thanh toán bổ sung ==

Actor -> Controller : GET /api/financial/supplement-records\n(?keyword, page, size)
activate Controller

Controller -> Service : getSupplementPendingRecords(page, size, keyword)
activate Service

Service -> SORepo : findSupplementPendingRecords(keyword, pageable)
activate SORepo
note right: orderType=SUPPLEMENT\nstatus=PENDING\ninvoiceId IS NULL
SORepo --> Service : Page<UnpaidRecordProjection>
deactivate SORepo

loop Mỗi Projection
  Service -> Service : Map → FinancialResponse
end

Service --> Controller : PageResponse<FinancialResponse>
deactivate Service

Controller --> Actor : 200 OK
deactivate Controller

== Luồng 3: Danh sách tất cả hóa đơn ==

Actor -> Controller : GET /api/financial/invoices\n(?keyword, paymentStatus, page, size)
activate Controller

Controller -> Service : getInvoices(page, size, keyword, paymentStatus)
activate Service

Service -> InvRepo : findByFilters(keyword, paymentStatus, pageable)
activate InvRepo
InvRepo --> Service : Page<Invoice>
deactivate InvRepo

loop Mỗi Invoice
  Service -> SORepo : findByInvoiceId(invoice.invoiceId)
  activate SORepo
  SORepo --> Service : List<ServiceOrder>
  deactivate SORepo

  Service -> Service : Lọc bỏ CANCELLED orders
  Service -> Service : Tạo serviceSummary (tên dịch vụ nối ", ")
  Service -> Service : Map → FinancialResponse
end

Service --> Controller : PageResponse<FinancialResponse>
deactivate Service

Controller --> Actor : 200 OK
deactivate Controller
@enduml


