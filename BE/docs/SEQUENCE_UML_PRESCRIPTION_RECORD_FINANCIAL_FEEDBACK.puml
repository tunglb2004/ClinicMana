activate Controller

Controller -> Service : getReviewsByDoctor(doctorId, page, size)
activate Service

Service -> ReviewRepo : findByDoctorId(doctorId, pageable)
activate ReviewRepo
note right: WHERE doctor.doctorId = ?\nAND isDeleted = false
ReviewRepo --> Service : Page<Review>
deactivate ReviewRepo

Service -> Service : toPageResponse(page)
Service --> Controller : PageResponse<ReviewResponse>
deactivate Service

Controller --> Actor : 200 OK
deactivate Controller
