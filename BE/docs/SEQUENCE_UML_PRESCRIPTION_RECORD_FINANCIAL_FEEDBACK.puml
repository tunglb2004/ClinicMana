' ===================================================================
' Sequence diagrams cho 12 chức năng:
'   23-25: Prescription (Create, Update, Export)
'   26-29: Medical Record (History, Details, Status, Confirm)
'   30-31: Financial (List, Details)
'   32-34: Feedback (List, Details, Send Response)
' ===================================================================


' ======================== CHỨC NĂNG 23 ========================
@startuml
title 23. Tạo đơn thuốc (Create Prescription)
skinparam monochrome true
skinparam shadowing false

actor "Bác sĩ / Y tá" as Actor
participant "PrescriptionController" as Controller
participant "PrescriptionService" as Service
participant "MedicalRecordRepository" as MRRepo
participant "PrescriptionRepository" as PresRepo
participant "PrescriptionDetailRepository" as DetailRepo

Actor -> Controller : POST /api/medical-examination/prescriptions/issue\n(PrescriptionRequest)
activate Controller

Controller -> Service : issue(request)
activate Service

Service -> MRRepo : findById(request.medicalRecordId)
activate MRRepo
MRRepo --> Service : Optional<MedicalRecord>
deactivate MRRepo

alt Không tìm thấy bệnh án
  Service --> Controller : AppException(MEDICAL_RECORD_NOT_FOUND)
  Controller --> Actor : 404 Error
else Trạng thái ≠ EXAMINING
  Service --> Controller : AppException(MEDICAL_RECORD_NOT_EXAMINING)
  Controller --> Actor : 400 Error
end

Service -> Service : generateId("PRES-" + UUID 8 ký tự)

Service -> PresRepo : save(prescription)
activate PresRepo
PresRepo --> Service : Prescription
deactivate PresRepo

loop Mỗi chi tiết thuốc trong request.details
  Service -> Service : Tạo PrescriptionDetail\n(medicineName, dosage, quantity)
end

Service -> DetailRepo : saveAll(details)
activate DetailRepo
DetailRepo --> Service : List<PrescriptionDetail>
deactivate DetailRepo

Service -> Service : mapToResponse(prescription)
Service --> Controller : PrescriptionResponse
deactivate Service

Controller --> Actor : 200 OK\nApiResponse<PrescriptionResponse>
deactivate Controller
@enduml


' ======================== CHỨC NĂNG 24 ========================
@startuml
title 24. Cập nhật đơn thuốc (Update Prescription)
skinparam monochrome true
skinparam shadowing false

actor "Bác sĩ / Y tá" as Actor
participant "PrescriptionController" as Controller
participant "PrescriptionService" as Service
participant "PrescriptionRepository" as PresRepo
participant "PrescriptionDetailRepository" as DetailRepo

Actor -> Controller : PUT /api/medical-examination/prescriptions/update-detail/{id}\n(PrescriptionRequest)
activate Controller

Controller -> Service : updateDetail(id, request)
activate Service

Service -> PresRepo : findById(id)
activate PresRepo
PresRepo --> Service : Optional<Prescription>
deactivate PresRepo

alt Không tìm thấy đơn thuốc
  Service --> Controller : AppException(PRESCRIPTION_NOT_FOUND)
  Controller --> Actor : 404 Error
end

Service -> Service : Kiểm tra MedicalRecord.status\n≠ FINISHED, ≠ CANCELLED

alt Trạng thái không hợp lệ
  Service --> Controller : AppException(MEDICAL_RECORD_ALREADY_FINISHED)
  Controller --> Actor : 400 Error
end

Service -> DetailRepo : deleteByPrescription(prescription)
activate DetailRepo
DetailRepo --> Service : void
deactivate DetailRepo

loop Mỗi chi tiết thuốc mới
  Service -> Service : Tạo PrescriptionDetail mới\n(medicineName, dosage, quantity)
end

Service -> DetailRepo : saveAll(newDetails)
activate DetailRepo
DetailRepo --> Service : List<PrescriptionDetail>
deactivate DetailRepo

Service -> Service : Cập nhật notes (nếu có)

Service -> PresRepo : save(prescription)
activate PresRepo
PresRepo --> Service : Prescription
deactivate PresRepo

Service -> Service : mapToResponse(prescription)
Service --> Controller : PrescriptionResponse
deactivate Service

Controller --> Actor : 200 OK\nApiResponse<PrescriptionResponse>
deactivate Controller
@enduml


