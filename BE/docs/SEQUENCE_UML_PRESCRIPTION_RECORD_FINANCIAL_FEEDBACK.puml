' ======================== CHỨC NĂNG 34 ========================
@startuml
title 34. Gửi phản hồi (Send Response to Feedback)
skinparam monochrome true
skinparam shadowing false

actor "Bác sĩ / Admin" as Actor
participant "ReviewController" as Controller
participant "ReviewService" as Service
participant "ReviewRepository" as ReviewRepo
participant "UserRepository" as UserRepo

Actor -> Controller : PUT /api/reviews/{reviewId}/reply\n(ReplyReviewRequest { replyContent })
activate Controller

Controller -> Controller : Lấy userId từ\nSecurityContextHolder

Controller -> Service : replyReview(reviewId, request, userId)
activate Service

Service -> ReviewRepo : findByReviewIdAndIsDeletedFalse(reviewId)
activate ReviewRepo
ReviewRepo --> Service : Optional<Review>
deactivate ReviewRepo

alt Không tìm thấy đánh giá
  Service --> Controller : AppException(REVIEW_NOT_FOUND)
  Controller --> Actor : 404 Error
end

alt Đã có phản hồi trước đó
  Service -> Service : review.getReplyContent() != null?
  Service --> Controller : AppException(REVIEW_ALREADY_REPLIED)
  Controller --> Actor : 400 Error\n"Đánh giá này đã được phản hồi"
end

Service -> UserRepo : findById(userId)
activate UserRepo
UserRepo --> Service : Optional<User>
deactivate UserRepo

Service -> Service : review.setReplyContent(request.replyContent)
Service -> Service : review.setReplyBy(user)
Service -> Service : review.setReplyAt(LocalDateTime.now())

Service -> ReviewRepo : save(review)
activate ReviewRepo
ReviewRepo --> Service : Review
deactivate ReviewRepo

Service -> Service : Map → ReviewResponse

Service --> Controller : ReviewResponse
deactivate Service

Controller --> Actor : 200 OK\nApiResponse<ReviewResponse>
deactivate Controller
@enduml
