' PlantUML sequence diagrams mapped to current FE/BE implementation.
' FE is modeled as a single boundary lifeline between actor and backend.

@startuml
title View customer accounts list
autonumber
hide footbox

actor Staff

box "Clinic Management System"
boundary ": CustomerAccountsPage (FE)" as FE
control ": PatientManagementController" as PatientController
control ": PatientManagementService" as PatientService
database ": UserRepository" as UserRepo
database ": MainDatabase" as DB
end box

Staff -> FE: Open customer accounts list
activate FE
FE -> PatientController: GET /api/admin/patients/list(page,size,sortBy,sortDir,keyword,isActive)
activate PatientController
PatientController -> PatientService: getAllPatients(page,size,sortBy,sortDir,keyword,isActive)
activate PatientService

alt keyword is provided
    PatientService -> UserRepo: findByRoleAndKeyword("ROLE_PATIENT", keyword, false, pageable)
    activate UserRepo
    UserRepo -> DB: SELECT users by role + keyword + is_deleted = false
    activate DB
    return Page<User>
    return patientPage
else isActive is provided
    PatientService -> UserRepo: findByRoleAndIsActive("ROLE_PATIENT", isActive, false, pageable)
    activate UserRepo
    UserRepo -> DB: SELECT users by role + is_active + is_deleted = false
    activate DB
    return Page<User>
    return patientPage
else default listing
    PatientService -> UserRepo: findByRoleAndIsDeleted("ROLE_PATIENT", false, pageable)
    activate UserRepo
    UserRepo -> DB: SELECT users by role + is_deleted = false
    activate DB
    return Page<User>
    return patientPage
end

return PageResponse<UserDetailResponse>
return 200 OK + PageResponse<UserDetailResponse>
return Render customer accounts list
@enduml


@startuml
title Cancel customer information
autonumber
hide footbox

actor Cashier

box "Clinic Management System"
boundary ": CustomerAccountsPage (FE)" as FE
control ": PatientManagementController" as PatientController
control ": PatientManagementService" as PatientService
database ": UserRepository" as UserRepo
database ": MainDatabase" as DB
end box

Cashier -> FE: Click delete customer
activate FE
FE -> PatientController: DELETE /api/admin/patients/{userId}
activate PatientController
PatientController -> PatientService: deletePatient(userId)
activate PatientService
PatientService -> UserRepo: findById(userId)
activate UserRepo
UserRepo -> DB: SELECT user by user_id
activate DB
return User or empty
return User or empty

alt user not found / already deleted / not ROLE_PATIENT
    return RuntimeException
    return 4xx/5xx error
    return Show delete failure
else valid patient
    PatientService -> UserRepo: save(user{isDeleted=true,isActive=false})
    activate UserRepo
    UserRepo -> DB: UPDATE users SET is_deleted = true, is_active = false
    activate DB
    return updated user row
    return savedUser
    return MessageResponse("Xóa bệnh nhân thành công")
    return 200 OK + MessageResponse
    return Show delete success
end
@enduml


@startuml
title Update appointment and customer information
autonumber
hide footbox

actor Receptionist

box "Clinic Management System"
boundary ": AppointmentEditPage (FE)" as FE
control ": PatientManagementController" as PatientController
control ": PatientManagementService" as PatientService
control ": AppointmentController" as AppointmentController
control ": AppointmentService" as AppointmentService
database ": UserRepository" as UserRepo
database ": PatientRepository" as PatientRepo
database ": AppointmentRepository" as AppointmentRepo
database ": DoctorRepository" as DoctorRepo
database ": ServiceRepository" as ServiceRepo
database ": RoomRepository" as RoomRepo
database ": StaffScheduleRepository" as StaffScheduleRepo
database ": MainDatabase" as DB
end box

Receptionist -> FE: Submit customer and appointment changes
activate FE

FE -> PatientController: PUT /api/admin/patients/{userId}
activate PatientController
PatientController -> PatientService: updatePatient(userId, updatePatientRequest)
activate PatientService
PatientService -> UserRepo: findById(userId)
activate UserRepo
UserRepo -> DB: SELECT user by user_id
activate DB
return User or empty
return User
PatientService -> PatientRepo: findByUser_UserId(userId)
activate PatientRepo
PatientRepo -> DB: SELECT patient by user_id
activate DB
return Patient or empty
return Patient

opt email / phone / cccd is changed
    PatientService -> UserRepo: existsByEmail / existsByPhoneNumber / existsByCccd
    activate UserRepo
    UserRepo -> DB: SELECT duplicate check
    activate DB
    return boolean
    return duplicate result
end

PatientService -> UserRepo: save(updated User)
activate UserRepo
UserRepo -> DB: UPDATE users
activate DB
return updated User
return updatedUser
PatientService -> PatientRepo: save(updated Patient)
activate PatientRepo
PatientRepo -> DB: UPDATE patients
activate DB
return updated Patient
return updatedPatient
return UserDetailResponse
return 200 OK + customer update result

alt customer update failed
    return Show validation or save error
else customer update succeeded
    FE -> AppointmentController: PUT /api/appointments/{appointmentId}
    activate AppointmentController
    AppointmentController -> AppointmentService: updateAppointment(appointmentId, updateAppointmentRequest)
    activate AppointmentService
    AppointmentService -> AppointmentRepo: findById(appointmentId)
    activate AppointmentRepo
    AppointmentRepo -> DB: SELECT appointment by appointment_id
    activate DB
    return Appointment or empty
    return Appointment

    opt doctorId is provided
        AppointmentService -> DoctorRepo: findById(doctorId)
        activate DoctorRepo
        DoctorRepo -> DB: SELECT doctor by doctor_id
        activate DB
        return Doctor or empty
        return Doctor
    end

    opt serviceIds is provided
        AppointmentService -> ServiceRepo: findAllByServiceIdInAndIsDeletedFalseAndIsActiveTrue(serviceIds)
        activate ServiceRepo
        ServiceRepo -> DB: SELECT active services by service_id list
        activate DB
        return List<Service>
        return services
    end

    opt roomId or doctor/date/time changes
        AppointmentService -> RoomRepo: findByRoomIdAndIsDeletedFalse(roomId)
        activate RoomRepo
        RoomRepo -> DB: SELECT room by room_id
        activate DB
        return Room or empty
        return Room
        opt doctor + date + time are present
            AppointmentService -> StaffScheduleRepo: findFirstByUser_UserIdAndWorkDateAndSlot_SlotIdAndRoom_RoomId(...)
            activate StaffScheduleRepo
            StaffScheduleRepo -> DB: SELECT staff schedule by doctor + work date + slot + room
            activate DB
            return schedule or empty
            return schedule or empty
        end
    end

    AppointmentService -> AppointmentRepo: save(updated Appointment)
    activate AppointmentRepo
    AppointmentRepo -> DB: UPDATE appointments and appointment_services
    activate DB
    return updated Appointment
    return updatedAppointment
    return AppointmentResponse
    return 200 OK + appointment update result
    return Show combined update success
end
@enduml


