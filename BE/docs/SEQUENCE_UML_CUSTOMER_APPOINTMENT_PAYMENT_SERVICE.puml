@startuml
title Collect prepayment for general examination (cash or QR)
autonumber
hide footbox

actor Cashier

box "Clinic Management System"
boundary ": PrepaymentPage (FE)" as FE
control ": PaymentController" as PaymentController
control ": PaymentService" as PaymentService
control ": CitizenInsuranceService" as InsuranceService
control ": LoadBalancingService" as BalancingService
database ": InvoiceRepository" as InvoiceRepo
database ": AppointmentRepository" as AppointmentRepo
database ": MedicalRecordRepository" as MedicalRecordRepo
database ": ServiceOrderRepository" as ServiceOrderRepo
database ": RoomRepository" as RoomRepo
database ": MainDatabase" as DB
end box

Cashier -> FE: Confirm prepayment
activate FE
FE -> PaymentController: POST /api/payments/prepayment
activate PaymentController
PaymentController -> PaymentService: collectPrepayment(prepaymentRequest)
activate PaymentService
PaymentService -> InvoiceRepo: existsByMedicalRecord_Appointment_AppointmentIdAndPaymentStatus(appointmentId, "PAID")
activate InvoiceRepo
InvoiceRepo -> DB: SELECT EXISTS paid invoice by appointment_id
activate DB
return boolean
return alreadyPaid?

alt appointment already paid
    return AppException(PAYMENT_ALREADY_PAID)
    return 4xx error
    return Show payment failure
else appointment is unpaid
    PaymentService -> AppointmentRepo: findById(appointmentId)
    activate AppointmentRepo
    AppointmentRepo -> DB: SELECT appointment with selected services
    activate DB
    return Appointment or empty
    return Appointment

    alt cccdNumber is provided and insurance is valid
        PaymentService -> InsuranceService: calculateInsuranceForServices(cccdNumber, appointment.services)
        activate InsuranceService
        return InsuranceBreakdownResponse
    else no valid insurance
        note over PaymentService
        insurancePaid = 0
        customerPaid = totalServiceFee
        end note
    end

    PaymentService -> MedicalRecordRepo: findByAppointment(appointment)
    activate MedicalRecordRepo
    MedicalRecordRepo -> DB: SELECT medical_record by appointment_id
    activate DB
    return MedicalRecord or null
    return MedicalRecord or null

    alt medical record does not exist
        PaymentService -> MedicalRecordRepo: save(new MedicalRecord)
        activate MedicalRecordRepo
        MedicalRecordRepo -> DB: INSERT medical_record
        activate DB
        return saved MedicalRecord
        return MedicalRecord
    end

    alt paymentMethod = CASH
        note over PaymentService
        paymentStatus = PAID
        message = "Thanh toán tiền mặt thành công."
        end note
    else paymentMethod = QR or TRANSFER
        note over PaymentService
        paymentStatus = PENDING
        generate invoiceId and paymentUrl
        end note
    end

    PaymentService -> InvoiceRepo: save(invoice)
    activate InvoiceRepo
    InvoiceRepo -> DB: INSERT invoice
    activate DB
    return saved Invoice
    return Invoice

    loop for each service in appointment.services
        PaymentService -> ServiceOrderRepo: save(serviceOrder)
        activate ServiceOrderRepo
        ServiceOrderRepo -> DB: INSERT service_order
        activate DB
        return saved ServiceOrder
        return ServiceOrder
    end

    alt paymentStatus = PAID
        PaymentService -> BalancingService: findOptimalDoctor(deptId, currentDoctorId)
        activate BalancingService
        return optimalDoctor or null
        PaymentService -> AppointmentRepo: save(appointment{status="WAITING", doctor/room updated, priorityScore=0, waitingSince=now})
        activate AppointmentRepo
        AppointmentRepo -> DB: UPDATE appointments
        activate DB
        return updated Appointment
        return Appointment
        opt assigned room exists
            PaymentService -> RoomRepo: save(room{currentQueueLength + 1})
            activate RoomRepo
            RoomRepo -> DB: UPDATE rooms SET current_queue_length = current_queue_length + 1
            activate DB
            return updated Room
            return Room
        end
    else paymentStatus = PENDING
        note over PaymentService
        return paymentUrl to FE
        FE will show QR for the cashier
        end note
    end

    return PaymentResponse
    return 200 OK + PaymentResponse

    alt paymentStatus = PAID
        return Show cash payment success
    else paymentStatus = PENDING
        return Show QR code and pending status
    end
end
@enduml


@startuml
title Service catalog management
autonumber
hide footbox

actor ClinicManager

box "Clinic Management System"
boundary ": ServiceCatalogPage (FE)" as FE
control ": ServiceController" as ServiceController
control ": ServiceManagementService" as ServiceManagementService
database ": ServiceRepository" as ServiceRepo
database ": DepartmentRepository" as DepartmentRepo
database ": MainDatabase" as DB
end box

ClinicManager -> FE: Manage service catalog
activate FE

alt View service list
    FE -> ServiceController: GET /api/services(includeInactive, category, deptId)
    activate ServiceController
    ServiceController -> ServiceManagementService: getVisibleServices(includeInactive)
    activate ServiceManagementService
    alt includeInactive = true
        ServiceManagementService -> ServiceRepo: findAllByIsDeletedFalse()
        activate ServiceRepo
        ServiceRepo -> DB: SELECT services where is_deleted = false
        activate DB
        return List<Service>
        return services
    else includeInactive = false
        ServiceManagementService -> ServiceRepo: findAllByIsDeletedFalseAndIsActiveTrue()
        activate ServiceRepo
        ServiceRepo -> DB: SELECT active services where is_deleted = false
        activate DB
        return List<Service>
        return services
    end
    return List<Service>
    return 200 OK + filtered service list
    return Render services

else Create new service
    FE -> ServiceController: POST /api/services
    activate ServiceController
    ServiceController -> ServiceManagementService: createService(serviceCatalogRequest)
    activate ServiceManagementService
    ServiceManagementService -> ServiceRepo: findAll()
    activate ServiceRepo
    ServiceRepo -> DB: SELECT all services for next serviceId
    activate DB
    return List<Service>
    return allServices
    opt deptId is provided
        ServiceManagementService -> DepartmentRepo: findByDeptIdAndIsDeletedFalse(deptId)
        activate DepartmentRepo
        DepartmentRepo -> DB: SELECT department by dept_id
        activate DB
        return Department or empty
        return Department
    end
    ServiceManagementService -> ServiceRepo: save(new Service)
    activate ServiceRepo
    ServiceRepo -> DB: INSERT service
    activate DB
    return saved Service
    return Service
    return Service
    return 200 OK + created Service
    return Show create success

else Update existing service
    FE -> ServiceController: PUT /api/services/{serviceId}
    activate ServiceController
    ServiceController -> ServiceManagementService: updateService(serviceId, serviceCatalogRequest)
    activate ServiceManagementService
    ServiceManagementService -> ServiceRepo: findByServiceIdAndIsDeletedFalse(serviceId)
    activate ServiceRepo
    ServiceRepo -> DB: SELECT service by service_id
    activate DB
    return Service or empty
    return Service
    opt deptId is provided
        ServiceManagementService -> DepartmentRepo: findByDeptIdAndIsDeletedFalse(deptId)
        activate DepartmentRepo
        DepartmentRepo -> DB: SELECT department by dept_id
        activate DB
        return Department or empty
        return Department
    end
    ServiceManagementService -> ServiceRepo: save(updated Service)
    activate ServiceRepo
    ServiceRepo -> DB: UPDATE services
    activate DB
    return updated Service
    return Service
    return Service
    return 200 OK + updated Service
    return Show update success

else Lock or unlock service
    FE -> ServiceController: PATCH /api/services/{serviceId}/status
    activate ServiceController
    ServiceController -> ServiceManagementService: updateServiceStatus(serviceId, isActive)
    activate ServiceManagementService
    ServiceManagementService -> ServiceRepo: findByServiceIdAndIsDeletedFalse(serviceId)
    activate ServiceRepo
    ServiceRepo -> DB: SELECT service by service_id
    activate DB
    return Service or empty
    return Service
    ServiceManagementService -> ServiceRepo: save(service{isActive})
    activate ServiceRepo
    ServiceRepo -> DB: UPDATE services SET is_active = ?
    activate DB
    return updated Service
    return Service
    return Service
    return 200 OK + Service
    return Show status update success

else Soft delete service
    FE -> ServiceController: DELETE /api/services/{serviceId}
    activate ServiceController
    ServiceController -> ServiceManagementService: deleteService(serviceId)
    activate ServiceManagementService
    ServiceManagementService -> ServiceRepo: findByServiceIdAndIsDeletedFalse(serviceId)
    activate ServiceRepo
    ServiceRepo -> DB: SELECT service by service_id
    activate DB
    return Service or empty
    return Service
    ServiceManagementService -> ServiceRepo: save(service{isActive=false,isDeleted=true})
    activate ServiceRepo
    ServiceRepo -> DB: UPDATE services SET is_active = false, is_deleted = true
    activate DB
    return updated Service
    return Service
    return void
    return 200 OK + delete success message
    return Show delete success
end
@enduml